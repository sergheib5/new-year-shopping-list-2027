rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isBuiltInStoreName(name) {
      return name.lower() in ['fresh farm', 'aldi', 'costco', 'other'];
    }

    // Shopping List Collection
    match /shoppingList/{document=**} {
      allow read, write: if true;
    }
    
    // Menu Collection
    match /menu/{document=**} {
      allow read, write: if true;
    }

    // Custom store records: public read, validated create, and custom-only delete.
    // Fields: name (string, 1–40 chars, also used as the lowercase document ID),
    // createdAt (timestamp). Store names are immutable after creation.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.name.matches('^[^/]+$')
        && request.resource.data.name != '.'
        && request.resource.data.name != '..'
        && !isBuiltInStoreName(request.resource.data.name)
        && storeId == request.resource.data.name.lower()
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if resource.data.keys().hasAll(['name', 'createdAt'])
        && resource.data.keys().hasOnly(['name', 'createdAt'])
        && resource.data.name is string
        && !isBuiltInStoreName(resource.data.name)
        && storeId == resource.data.name.lower();
    }
  }
}


